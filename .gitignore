# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/i18n-coverage-report.json
/i18n-coverage-report.md
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/
/load-tests/results/*
!/load-tests/results/.gitkeep

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.log
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example only
.env
.env.*
!.env.example

# AES-256-GCM encrypted vault blobs (no plaintext) are safe to commit
!/secrets/vault/
!/secrets/vault/*.enc
!/secrets/rotation-manifest.json

# Local Postgres dump archives (scripts/backup-db.sh)
/backups/

# local sqlite
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri / rust
/src-tauri/target
/src-tauri/ui-dist
/src-tauri/gen
/src-tauri/WixTools
*.key
!*.key.pub
*.p12
*.cer
*.certSigningRequest
*.p12.base64
*.sig

# IDE / local agent skill mirrors (not part of the product)
.idea/
.vscode/
.agents/
.claude/
.cursor/
.devin/
.codex/
*.swp
*~

# OS
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# docker / local volumes
docker-data/

*storybook.log
storybook-static
