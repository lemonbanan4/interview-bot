{
  "manifest_version": 3,
  "name": "AI Interview Copilot Stealth HUD",
  "version": "1.0.0",
  "description": "Real-time AI interview hints and coaching overlay for Meet and Zoom.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "http://localhost:3000/*",
    "https://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Signal Copilot",
    "default_popup": "popup.html"
  }
}
