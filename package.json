{
  "name": "interview-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:docs": "tsx scripts/generate-openapi.ts && tsx scripts/export-erd.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "export:erd": "tsx scripts/export-erd.ts",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/i18n/validate-keys.ts",
    "i18n:check:strict": "tsx scripts/i18n/validate-keys.ts --strict-orphans",
    "lint:rust": "./scripts/check-rust.sh",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run lint:rust",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:safe": "./scripts/db/migrate-with-hooks.sh",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:lint-migrations": "tsx scripts/db/lint-migrations.ts",
    "db:health": "tsx scripts/db/health-check.ts",
    "db:shadow-migrate": "tsx scripts/db/shadow-migrate.ts",
    "db:analyze": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/db-analyzer.sql",
    "db:analyze:indexes": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/analyze-indexes.sql",
    "db:logging:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/apply-pg-slow-query-logging.sql",
    "db:report": "tsx scripts/db-report.ts",
    "deploy": "./scripts/deploy/deploy.sh",
    "deploy:rollback": "./scripts/deploy/rollback.sh",
    "deploy:health": "./scripts/deploy/wait-for-health.sh",
    "deploy:smoke": "./scripts/deploy/smoke-detailed.sh",
    "db:backup": "./scripts/backup/backup-db.sh",
    "db:backup:verify": "./scripts/backup/backup-db.sh --verify",
    "db:restore:dry-run": "./scripts/backup/restore-db.sh --latest --dry-run",
    "db:restore:verify": "./scripts/backup/restore-db.sh --latest --verify-container",
    "release:bump": "node scripts/release/bump-version.mjs --dry-run",
    "release:bump:write": "node scripts/release/bump-version.mjs --write",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "postinstall": "prisma generate",
    "tauri": "tauri",
    "tauri:prepare-ui": "node scripts/prepare-tauri-ui.mjs",
    "tauri:dev": "npm run tauri:prepare-ui && tauri dev",
    "tauri:build": "npm run tauri:prepare-ui && tauri build",
    "tauri:build:dmg": "npm run tauri:prepare-ui && tauri build --bundles app,dmg",
    "tauri:build:msi": "npm run tauri:prepare-ui && tauri build --bundles msi,nsis",
    "secrets:store": "./scripts/secrets-keychain.sh store-from-env",
    "secrets:export": "./scripts/secrets-keychain.sh export",
    "secrets:sync-github": "./scripts/secrets-keychain.sh sync-github",
    "secrets:keygen": "tsx scripts/secrets/manager.ts keygen",
    "secrets:encrypt": "tsx scripts/secrets/manager.ts encrypt",
    "secrets:decrypt": "tsx scripts/secrets/manager.ts decrypt",
    "secrets:validate": "tsx scripts/secrets/manager.ts validate",
    "secrets:list": "tsx scripts/secrets/manager.ts list",
    "secrets:sync": "tsx scripts/secrets/sync-railway.ts",
    "secrets:rotate-audit": "tsx scripts/secrets/rotate-audit.ts",
    "env:validate": "tsx scripts/secrets/validate-env.ts",
    "desktop:notarize-wait": "./scripts/notarize-wait.sh",
    "desktop:publish-release": "./scripts/publish-github-release.sh",
    "db:seed": "prisma db seed",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:seed:reset": "prisma migrate reset --force",
    "test:e2e": "E2E_BROWSERS=chromium playwright test --config=e2e/playwright.config.ts --project=chromium",
    "test:e2e:browsers": "E2E_BROWSERS=chromium,firefox,webkit playwright test --config=e2e/playwright.config.ts --project=chromium --project=firefox --project=webkit",
    "test:e2e:tauri": "E2E_TAURI=1 E2E_BROWSERS=chromium playwright test --config=e2e/playwright.config.ts --project=tauri",
    "test:e2e:ui": "E2E_BROWSERS=chromium playwright test --config=e2e/playwright.config.ts --project=chromium --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen --config=e2e/playwright.config.ts",
    "test:visual": "playwright test --config=e2e/visual/playwright.config.ts --project=visual-chromium",
    "test:visual:percy": "percy exec -- npm run test:visual",
    "test:visual:storybook": "VISUAL_WITH_STORYBOOK=1 percy exec -- npm run test:visual",
    "test:a11y": "playwright test --config=e2e/a11y/playwright.config.ts --project=a11y-chromium",
    "test:a11y:report": "playwright show-report playwright-report/a11y",
    "test:unit": "vitest run --project unit",
    "test:security": "vitest run --project unit __tests__/security.test.ts",
    "test:migrations": "vitest run --config vitest.migrations.config.ts",
    "test:migrations:docker": "./scripts/test-migrations.sh",
    "test:storybook": "vitest run --project storybook",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks detect --source . -c .gitleaks.toml --verbose --redact",
    "security:hooks": "./scripts/install-git-hooks.sh",
    "ci:ai-review": "tsx scripts/ci/ai-review.ts",
    "ci:ai-review:dry": "AI_REVIEW_DRY_RUN=1 tsx scripts/ci/ai-review.ts",
    "audit:retain": "tsx scripts/audit/retain.ts",
    "release:notes": "node scripts/generate-release-notes.mjs --out release-notes.md",
    "test:load": "k6 run load-tests/api-benchmark.js",
    "test:load:smoke": "K6_SCENARIO=smoke k6 run load-tests/api-benchmark.js",
    "test:load:average": "K6_SCENARIO=average k6 run load-tests/api-benchmark.js",
    "test:load:stress": "K6_SCENARIO=stress k6 run load-tests/api-benchmark.js",
    "test:load:spike": "K6_SCENARIO=spike k6 run load-tests/api-benchmark.js",
    "test:load:soak": "K6_SCENARIO=soak k6 run load-tests/api-benchmark.js",
    "test:load:ci": "K6_SCENARIO=ci_gate K6_SKIP_STREAMS=1 k6 run load-tests/api-benchmark.js",
    "test:load:full": "K6_SCENARIO=full k6 run load-tests/api-benchmark.js",
    "test:load:interview": "k6 run load-tests/interview-load.js",
    "test:load:copilot": "k6 run load-tests/copilot-load-test.js",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/react": "^4.0.167",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@auth/prisma-adapter": "^2.11.3",
    "@deepgram/sdk": "^5.18.0",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.11.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.163",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-swagger-doc": "^0.4.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "openai": "^7.53.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.4",
    "redis": "^6.3.1",
    "resend": "^6.37.0",
    "stripe": "^23.1.0",
    "swagger-ui-react": "^5.34.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "latest",
    "@percy/cli": "^1.32.12",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^3.2.7"
  }
}
