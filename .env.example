# =============================================================================
# Docker Compose secrets & service mapping
#   cp .env.example .env && docker compose up --build -d
#
# Partitioning rules:
#   • POSTGRES_*     → postgres container only (credentials for initdb)
#   • DATABASE_URL   → host tools / local `next dev` (Compose app overrides to
#                      postgresql://…@postgres:5432/… inside the cluster)
#   • REDIS_URL      → host tools; Compose app uses redis://redis:6379
#   • AUTH_SECRET    → app only (Auth.js / JWT) — REQUIRED before compose up
#   • STRIPE_*       → app only (never injected into postgres/redis)
#   • OPENAI_* / ANTHROPIC_* / DEEPGRAM_* → app only
#   • NEXT_PUBLIC_*  → safe for client bundle; passed as Docker build args
# =============================================================================

# --- Encrypted secret vault (scripts/secrets + .github/workflows/sync-secrets.yml) ---
# AES-256-GCM store for .env.production / .env.staging (committed under secrets/vault/*.enc).
#   npm run secrets:keygen                         # → SECRETS_MASTER_KEY (GitHub secret)
#   npm run secrets:encrypt -- --env production --input .env.production
#   npm run secrets:validate -- --env staging
#   npm run secrets:sync -- --env staging          # Railway upsert (values never logged)
#   npm run secrets:rotate-audit -- --fail-on-stale
#   npm run env:validate                           # Zod check against current process.env
# SECRETS_MASTER_KEY=                              # 64 hex chars (32 bytes) — never commit
# Runtime Zod gate: src/lib/env.ts (next.config + instrumentation)
# SKIP_ENV_VALIDATION=1                            # escape hatch for unit tests
# ENV_VALIDATION=strict|warn|off

# --- Railway zero-downtime deploy (scripts/deploy + .github/workflows/deploy.yml) ---
# GitHub Actions secrets (production environment):
#   RAILWAY_TOKEN              # project token for CLI + GraphQL rollback (required)
#   RAILWAY_SERVICE_ID         # optional — multi-service projects
#   RAILWAY_ENVIRONMENT        # optional — e.g. production
#   DATABASE_URL               # prisma migrate deploy before promote
#   PRODUCTION_HEALTH_URL      # https://your-app.up.railway.app/api/health/live
#   PRODUCTION_APP_URL         # https://your-app.up.railway.app (detailed smoke base)
#   HEALTH_PING_SECRET         # Bearer for /api/health/detailed when gated
#   DEPLOY_WEBHOOK_URL         # optional Slack/Discord notify
# Local promote:
#   RAILWAY_TOKEN=… HEALTH_URL=https://…/api/health/live npm run deploy
#   npm run deploy:smoke       # post-promote GET /api/health/detailed
#   npm run deploy:rollback
#   npm run release:bump       # preview SemVer from conventional commits
# Railway keeps prior container live until /api/health/live returns 2xx
# (see railway.json healthcheckPath + overlapSeconds / drainingSeconds).

# --- Postgres (docker compose `postgres` service) ---
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal
POSTGRES_DB=interview_bot
# Optional host port binds (loopback by default — see docker-compose.yml)
# COMPOSE_POSTGRES_PORT=127.0.0.1:5432
# COMPOSE_REDIS_PORT=127.0.0.1:6379
# COMPOSE_APP_PORT=3000
# COMPOSE_APP_TAG=local
# REDIS_MAXMEMORY=256mb

# --- Database (host / Prisma CLI) ---
# Local PostgreSQL via docker compose:
#   docker compose up -d postgres redis
DATABASE_URL="postgresql://signal:signal@localhost:5432/interview_bot?schema=public"
#
# Multi-region read replicas (src/lib/db) — writes always use DATABASE_URL.
# Geo proxy sets x-signal-db-region (eu=Frankfurt, us=Virginia, apac=Tokyo).
# Circuit breaker falls back to primary on latency spikes / connection failures.
# DATABASE_REPLICA_EU_URL="postgresql://…eu-central-1…/interview_bot"
# DATABASE_REPLICA_US_URL="postgresql://…us-east-1…/interview_bot"
# DATABASE_REPLICA_APAC_URL="postgresql://…ap-northeast-1…/interview_bot"
# DATABASE_READ_REPLICA_URL=                 # optional single replica (maps to us)
# DB_REPLICA_TIMEOUT_MS=1500
# DB_REPLICA_LATENCY_BUDGET_MS=800
# DB_CIRCUIT_FAILURE_THRESHOLD=3
# DB_CIRCUIT_OPEN_MS=30000

# --- Automated Postgres backups (scripts/backup/) ---
# pg_dump -Fc → SHA-256 → GPG AES-256 → S3/R2 (+ optional Railway volume)
# Tiered retention prefixes: daily/ (14d), weekly/ (90d), monthly/ (365d)
#
# BACKUP_S3_BUCKET=signal-db-backups-prod
# BACKUP_S3_PREFIX=interview-bot/postgres
# BACKUP_RETENTION_DAYS=30
# BACKUP_RETENTION_DAILY_DAYS=14
# BACKUP_RETENTION_WEEKLY_DAYS=90
# BACKUP_RETENTION_MONTHLY_DAYS=365
# BACKUP_TIMEOUT_SEC=1800
# BACKUP_SSE=AES256
# BACKUP_GPG_PASSPHRASE=                    # symmetric AES-256 (recommended)
# # BACKUP_GPG_RECIPIENT=backup@yourdomain.com
# # BACKUP_KEEP_PLAINTEXT=0
# BACKUP_VOLUME_DIR=/data/backups           # optional Railway volume mirror
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# # Or rclone: BACKUP_RCLONE_REMOTE=r2:signal-db-backups-prod
# BACKUP_WEBHOOK_URL=                       # Slack or Discord incoming webhook
# # DISCORD_WEBHOOK_URL=
# # SLACK_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=                    # Events API v2 (failure/retention alerts)
# # SENTRY_DSN=
# # BACKUP_SENTRY_DSN=
# BACKUP_ALERT_EMAIL=ops@yourdomain.com
# BACKUP_NOTIFY_SUCCESS=0
# BACKUP_VERIFY_IMAGE=pgvector/pgvector:pg16
# RESTORE_CONFIRM=0                         # set 1 / pass --yes for non-interactive restore
#
# Install cron: ./scripts/install-backup-cron.sh
# Nightly CI: .github/workflows/backup.yml (00:00 UTC)
#   ./scripts/backup/backup-db.sh --verify
#   ./scripts/backup/backup-db.sh --apply-lifecycle
#   ./scripts/backup/restore-db.sh --latest --dry-run
#   ./scripts/backup/restore-db.sh --latest --verify-container

# Local Redis (docker compose redis service) — token cache + rate limits
REDIS_URL="redis://localhost:6379"

# --- PostgreSQL query performance (scripts/db-report.ts + Prisma middleware) ---
# Compose applies log_min_duration_statement=250 + log_line_prefix via docker/postgres/postgresql.conf
# Managed Postgres: npm run db:logging:apply  (then restart if shared_preload_libraries changed)
# PRISMA_SLOW_QUERY_MS=200                 # client-side slow query threshold (default 200)
# DB_REPORT_WEBHOOK_URL=                   # Slack/Discord for weekly report (falls back to BACKUP_WEBHOOK_URL)
# DB_REPORT_EMAIL=ops@yourdomain.com       # Resend recipient (falls back to BACKUP_ALERT_EMAIL)
# Install weekly cron: ./scripts/install-db-report-cron.sh
# CI: .github/workflows/db-report.yml (Mondays 08:00 UTC)
# Manual: npm run db:analyze && npm run db:report

# Auth.js / NextAuth v5 (JWT) — REQUIRED for docker compose `app`
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Nodemailer magic-link email (e.g. smtp://user:pass@smtp.example.com:587)
EMAIL_SERVER=
EMAIL_FROM="Signal <onboarding@yourdomain.com>"

# --- Playwright E2E (npm run test:e2e) ---
# Enables credentials provider + /api/e2e/* harness routes. Never set in prod.
# E2E_TEST_MODE=1
# E2E_BASE_URL=http://localhost:3000
# E2E_BROWSERS=chromium
# E2E_SKIP_DB=1   # UI-only runs without Postgres seed/teardown

# --- Enterprise SSO (OIDC / SAML / Okta / Azure AD / Google Workspace) ---
# Okta
# AUTH_OKTA_ID=
# AUTH_OKTA_SECRET=
# AUTH_OKTA_ISSUER=https://your-org.okta.com
# Microsoft Entra ID (Azure AD)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# Generic OIDC (Auth0, Keycloak, Cognito, custom)
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_ISSUER=https://idp.example.com
# AUTH_OIDC_WELL_KNOWN=https://idp.example.com/.well-known/openid-configuration
# AUTH_OIDC_NAME=Enterprise SSO
# SAML via BoxyHQ Jackson (OAuth facade; pass tenant+product at sign-in)
# AUTH_BOXYHQ_SAML_ISSUER=http://localhost:5225
# AUTH_BOXYHQ_SAML_CLIENT_ID=dummy
# AUTH_BOXYHQ_SAML_CLIENT_SECRET=dummy
# Workspace admins map email domains → protocol via PATCH /api/workspaces/:id/sso
# Discover: POST /api/auth/sso/discover { "email": "you@enterprise.com" }

# Transactional email delivery (welcome / low-credit / receipts)
# Preference: Resend → SendGrid → EMAIL_SERVER SMTP
RESEND_API_KEY=
# RESEND_FROM="Signal <onboarding@yourdomain.com>"  # optional override; defaults to EMAIL_FROM
SENDGRID_API_KEY=
# Cron auth for GET/POST /api/cron/* and /api/health/check (status worker)
CRON_SECRET=
# External uptime monitors (Better Stack / UptimeRobot) → GET/HEAD /api/health
# When set, require Authorization: Bearer <secret> or ?token=<secret>
HEALTH_PING_SECRET=
# UPTIME_PING_TOKEN=   # alias for HEALTH_PING_SECRET
# Optional Slack/Discord webhook fired when incidents open/resolve
# STATUS_WEBHOOK_URL=
# STATUS_WEBHOOK_SECRET=

# Comma-separated emails auto-promoted to ADMIN role on sign-in (control panel)
ADMIN_EMAILS=you@yourdomain.com

# Optional — OpenAI for coaching + review (primary live HUD provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# RAG embeddings (defaults to text-embedding-3-small / 1536-d)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — Anthropic Claude 3.5 Sonnet (automatic failover within 2.5s)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional — Deepgram for live STT
DEEPGRAM_API_KEY=

# --- Observability / security ---
# Sentry (leave blank to disable; client uses NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# production | staging | preview | development (auto from VERCEL_ENV when blank)
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional release name shared by Next.js + Tauri native SDK
# Prefer Git SHA: interview-bot@0.1.0+<sha> (auto from VERCEL_GIT_COMMIT_SHA / GITHUB_SHA)
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_RELEASE=
# Optional performance sample-rate overrides (0..1)
# SENTRY_TRACES_SAMPLE_RATE=0.15
# SENTRY_TRACES_SAMPLE_RATE_CLIENT=0.1
# SENTRY_TRACES_SAMPLE_RATE_SERVER=0.15
# SENTRY_TRACES_SAMPLE_RATE_EDGE=0.05
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Percy visual regression (e2e/visual + .github/workflows/visual-regression.yml)
# PERCY_TOKEN=                             # required in CI — Percy project token
# VISUAL_WITH_STORYBOOK=1                  # include Storybook iframe snapshots
# STORYBOOK_URL=http://127.0.0.1:6006
# Tauri desktop also reads SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN for Rust panics / minidumps

# Upstash Redis — Edge-safe rate limits (src/lib/rate-limit) + feature flags
# Prefer this for production proxy DDoS protection; falls back to REDIS_URL (Node) / memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Feature flags also use REDIS_URL when set (Node admin APIs). Edge proxy prefers Upstash.

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Point Stripe CLI / Dashboard at: POST /api/webhooks/stripe
# (legacy alias still works: /api/stripe/webhook)

# Optional — scrub user object prefixes on GDPR account delete (S3 / R2)
# GDPR_STORAGE_BUCKET=
# GDPR_STORAGE_PREFIX=interview-bot/users

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Price IDs from Stripe Dashboard
# Preferred: plan × currency × interval
# STRIPE_PRICE_{PRO|UNLIMITED|ENTERPRISE}_{USD|EUR|SEK|NOK}_{MONTHLY|YEARLY}=price_...
STRIPE_PRICE_PRO_USD_MONTHLY=price_...
STRIPE_PRICE_PRO_USD_YEARLY=price_...
STRIPE_PRICE_UNLIMITED_USD_MONTHLY=price_...
STRIPE_PRICE_UNLIMITED_USD_YEARLY=price_...
# Optional local-currency Prices (otherwise USD + Stripe Adaptive Pricing)
# STRIPE_PRICE_PRO_EUR_MONTHLY=price_...
# STRIPE_PRICE_PRO_SEK_MONTHLY=price_...
# STRIPE_PRICE_PRO_NOK_MONTHLY=price_...
# Legacy monthly fallbacks (Adaptive Pricing used for non-USD)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_UNLIMITED=price_...
# Fallback if plan-specific IDs unset
STRIPE_PRICE_SUBSCRIPTION=price_...
STRIPE_SUBSCRIPTION_CREDITS=300
STRIPE_PRICE_CREDITS_STARTER=price_...
STRIPE_PRICE_CREDITS_PRO=price_...
STRIPE_PRICE_CREDITS_STUDIO=price_...
# Fallback one-time credits price if pack-specific IDs are unset
STRIPE_PRICE_CREDITS=price_...

# Tauri desktop updater signing (CI only — never commit the private key)
# Generated with: npx tauri signer generate -w ~/.tauri/copilot-key.key
# Pubkey → src-tauri/tauri.conf.json plugins.updater.pubkey
# TAURI_SIGNING_PRIVATE_KEY="~/.tauri/copilot-key.key"   # path or key contents
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Grafana k6 load tests (NEVER enable in production)
# LOAD_TEST_MODE=1
# LOAD_TEST_SECRET=long-random-shared-with-k6
# Client: BASE_URL=http://localhost:3000 LOAD_TEST_SECRET=… K6_SCENARIO=smoke npm run test:load
# Stress: K6_SCENARIO=stress K6_MAX_VUS=100 npm run test:load:stress
# CI: .github/workflows/k6.yml → artifacts under load-tests/results/

# OTA update catalog (/api/update/check)
# Optional: override src-tauri/updater/latest.json entirely
# DESKTOP_RELEASE_JSON={"version":"0.1.1","notes":"...","pub_date":"...","platforms":{...}}
# Resolve signed assets from GitHub Releases (default on). Set 0 to disable.
# DESKTOP_UPDATE_GITHUB=1
# DESKTOP_RELEASE_REPO=lemonbanan4/interview-bot
# DESKTOP_GITHUB_TOKEN=   # optional PAT if the repo is private / rate-limited


# macOS code signing + notarization (Developer ID Application required for Gatekeeper)
# security find-identity -v -p codesigning
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_ID=
# APPLE_PASSWORD=          # app-specific password
# APPLE_TEAM_ID=

# Windows code signing (local builds)
# WINDOWS_CERTIFICATE=     # path to .pfx OR base64 contents in CI
# WINDOWS_CERTIFICATE_PASSWORD=
