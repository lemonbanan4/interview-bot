# --- Database ---
# Local PostgreSQL via docker compose:
#   docker compose up -d
DATABASE_URL="postgresql://signal:signal@localhost:5432/interview_bot?schema=public"

# Auth.js / NextAuth v5
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Nodemailer magic-link email (e.g. smtp://user:pass@smtp.example.com:587)
EMAIL_SERVER=
EMAIL_FROM="Signal <noreply@yourdomain.com>"

# Optional — OpenAI for coaching + review
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional — Deepgram for live STT
DEEPGRAM_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Price IDs from Stripe Dashboard
# Pro $29/mo and Unlimited $79/mo subscriptions
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_UNLIMITED=price_...
# Fallback if plan-specific IDs unset
STRIPE_PRICE_SUBSCRIPTION=price_...
STRIPE_SUBSCRIPTION_CREDITS=300
STRIPE_PRICE_CREDITS_STARTER=price_...
STRIPE_PRICE_CREDITS_PRO=price_...
STRIPE_PRICE_CREDITS_STUDIO=price_...
# Fallback one-time credits price if pack-specific IDs are unset
STRIPE_PRICE_CREDITS=price_...

# Tauri desktop updater signing (CI only — never commit the private key)
# Generated with: npx tauri signer generate -w ~/.tauri/copilot-key.key
# TAURI_SIGNING_PRIVATE_KEY="~/.tauri/copilot-key.key"   # path or key contents
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Optional: override src-tauri/updater/latest.json for /api/releases/latest
# DESKTOP_RELEASE_JSON={"version":"0.1.1","notes":"...","pub_date":"...","platforms":{...}}

# macOS code signing + notarization (Developer ID Application required for Gatekeeper)
# security find-identity -v -p codesigning
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_ID=
# APPLE_PASSWORD=          # app-specific password
# APPLE_TEAM_ID=

# Windows code signing (local builds)
# WINDOWS_CERTIFICATE=     # path to .pfx OR base64 contents in CI
# WINDOWS_CERTIFICATE_PASSWORD=
